---
/**
 * About Page
 * Developer Students Club • SRM IST Ramapuram
 *
 * Card interaction: handled by AboutSection.tsx (React, client:load).
 * Pattern: identical to DomainsSection.tsx + DomainCard.tsx.
 * Scope: ONLY about.astro + about.css + src/components/about/ changed.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.tsx';
import Footer from '../components/Footer.tsx';
import SideRays from '../components/SideRays.tsx';
import TechParticles from '../components/TechParticles.tsx';
import Watermark from '../components/Watermark.astro';
import AboutSection from '../components/about/AboutSection.tsx';
import '../styles/contact.css';
import '../styles/domains.css';
import '../styles/about.css';
---

<BaseLayout
  title="About — Developer Students Club | SRM IST Ramapuram"
  description="Learn about Developer Students Club, our mission, vision, and the community we build."
>
  <!-- Interactive WebGL SideRays Background -->
  <div class="side-rays-bg">
    <SideRays
      client:only="react"
      speed={1.1}
      rayColor1="#1dd1a1"
      rayColor2="#00f2fe"
      intensity={1.1}
      spread={2.2}
      origin="top-right"
      tilt={0}
      saturation={1.3}
      blend={0.7}
      falloff={1.5}
      opacity={0.6}
    />
  </div>

  <!-- Background Particles -->
  <TechParticles client:idle />

  <!-- Decorative Corner Circuit Graphics (identical to Domains) -->
  <svg class="corner-graphic corner-top-left" width="250" height="250" viewBox="0 0 250 250" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M0,50 L100,50 L150,100 L220,100" stroke="rgba(232, 237, 233, 0.4)" stroke-width="1.5" stroke-linecap="round" />
    <path d="M60,0 L60,80 L100,120 L150,120" stroke="rgba(232, 237, 233, 0.25)" stroke-width="1" stroke-linecap="round" />
    <circle cx="220" cy="100" r="3" fill="#1dd1a1" />
    <circle cx="150" cy="120" r="2" fill="rgba(232, 237, 233, 0.6)" />
  </svg>

  <svg class="corner-graphic corner-top-right" width="250" height="250" viewBox="0 0 250 250" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M250,50 L150,50 L100,100 L30,100" stroke="rgba(232, 237, 233, 0.4)" stroke-width="1.5" stroke-linecap="round" />
    <path d="M190,0 L190,80 L150,120 L100,120" stroke="rgba(232, 237, 233, 0.25)" stroke-width="1" stroke-linecap="round" />
    <circle cx="30" cy="100" r="3" fill="#1dd1a1" />
    <circle cx="100" cy="120" r="2" fill="rgba(232, 237, 233, 0.6)" />
  </svg>

  <!-- Marquee Ticker -->
  <div class="dsc-marquee-container">
    <div class="dsc-marquee-content">
      <div class="dsc-marquee-item">DEVELOPER STUDENTS CLUB • STUDENT DRIVEN • CREATIVE • COLLABORATIVE</div><div class="dsc-marquee-star">★</div>
      <div class="dsc-marquee-item">LEARN • CONNECT • CREATE • LEAD</div><div class="dsc-marquee-star">★</div>
      <div class="dsc-marquee-item">DEVELOPER STUDENTS CLUB • STUDENT DRIVEN • CREATIVE • COLLABORATIVE</div><div class="dsc-marquee-star">★</div>
      <div class="dsc-marquee-item">LEARN • CONNECT • CREATE • LEAD</div><div class="dsc-marquee-star">★</div>
    </div>
  </div>

  <!-- Navigation -->
  <Header client:load active="about" />

  <main class="contact-container about-container">
    <div class="contact-layout-wrapper about-layout-wrapper">
      <Watermark text="ABOUT" />

      <!--
        About content section — mirrors .domains-bottom-cta architecture.
        Wrapper establishes stacking context (z-index 10, isolation).
        Artworks sit at z-index 1, cards content at z-index 2.
      -->
      <section class="about-content-section">
        <!-- Decorative artwork 1: upper-left negative space -->
        <img
          src="/about/new_dsc_image-removebg-preview-removebg-preview.png"
          class="ab-deco-art ab-deco-top-left"
          alt=""
          aria-hidden="true"
        />

        <!-- Decorative artwork 2: bottom-right negative space -->
        <img
          src="/about/new_dsc_image-removebg-preview-removebg-preview.png"
          class="ab-deco-art ab-deco-bottom-right"
          alt=""
          aria-hidden="true"
        />

        <!-- Cards content at z-index: 2 — always above artworks -->
        <div class="about-cards-content" style="position: relative; z-index: 2; pointer-events: auto; width: 100%;">
          <AboutSection client:load />
        </div>

      </section>
    </div>
  </main>

  <Footer client:visible={{ rootMargin: '100px' }} active="about" />
</BaseLayout>
